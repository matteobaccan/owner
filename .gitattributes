# Maven wrapper: the POSIX launcher and its properties must keep LF, otherwise
# core.autocrlf=true rewrites them to CRLF and the trailing \r makes mvnw reject
# distributionUrl ("must match *-bin.zip"). The Windows batch launcher needs CRLF.
mvnw                                   text eol=lf
mvnw.cmd                               text eol=crlf
.mvn/wrapper/maven-wrapper.properties  text eol=lf

# The vendored toml-test corpus is data, not source, and several of its cases are
# *about* line endings: invalid/control/bare-cr.toml, string-lf.toml,
# valid/string/multiline-escaped-crlf.toml and a dozen more. Letting core.autocrlf
# rewrite them would change what each case tests and quietly move the conformance
# score, so the bytes are kept exactly as the suite published them.
owner-formats/src/test/resources/toml-test/** -text
