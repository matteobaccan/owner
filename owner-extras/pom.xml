<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.aeonbits.owner</groupId>
        <artifactId>owner-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <name>OWNER :: Extras</name>
    <artifactId>owner-extras</artifactId>
    <description>Additions to the OWNER library that require a third party library on the classpath, and are therefore kept out of the dependency-free core.</description>
    <packaging>jar</packaging>

    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <!-- forces the netty version pulled transitively by curator/zookeeper,
                 which lags behind the security patches (GHSA on netty-common < 4.1.118) -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.17.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- forces the zookeeper version pulled transitively by curator,
                 which lags behind the security patches (GHSAs fixed in 3.9.5) -->
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>3.9.5</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.aeonbits.owner</groupId>
            <artifactId>owner</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
            <version>5.9.0</version>
            <optional>true</optional>
        </dependency>
        <!-- HOCON is the one format whose specification is an implementation, so HoconLoader adapts the
             reference one instead of parsing it. Optional, and not transitive: nothing of this reaches
             anyone who does not ask for it. See HoconLoader for why it is not written by hand. -->
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>1.4.9</version>
            <optional>true</optional>
        </dependency>
        <!-- The two spellings of Bean Validation. Both optional, neither transitive, and neither reachable
             from a class this artifact loads before it is asked: see BeanValidator for why both are here
             rather than one, and JakartaBeanValidation for what keeps them off everybody else's class path.
             The API only - a provider is the user's choice, and the tests below make both choices. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>javax.validation</groupId>
            <artifactId>validation-api</artifactId>
            <version>2.0.1.Final</version>
            <optional>true</optional>
        </dependency>
        <!-- One provider per namespace, and deliberately not the same one twice: Hibernate Validator 6 and 8
             share the org.hibernate.validator package, so the javax and the jakarta side of it cannot sit on
             one class path. Apache BVal takes the other half, which is also the pair issue #201 was reported
             against. -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.1.Final</version>
            <scope>test</scope>
        </dependency>
        <!-- Hibernate Validator interpolates its messages with an expression language and refuses to start
             without an implementation of one -->
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>5.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.bval</groupId>
            <artifactId>bval-jsr</artifactId>
            <version>2.0.6</version>
            <scope>test</scope>
        </dependency>
        <!-- declared by BVal as provided, which means the user has to bring it -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-test</artifactId>
            <version>5.9.0</version>
            <optional>true</optional>
            <scope>test</scope>
            <exclusions>
                <!-- curator-test brings an outdated JUnit 5 that makes surefire switch provider
                     and breaks the JUnit 4 tests; only TestingServer is used here -->
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <!-- See the same instruction in the core module. This artifact shares no package
                             with the core one, which is what lets the two sit together on the module
                             path; SplitPackageTest is there to keep it that way. -->
                        <Automatic-Module-Name>org.aeonbits.owner.extras</Automatic-Module-Name>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
